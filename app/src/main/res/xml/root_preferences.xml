<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="cat_login"
        app:title="Login">

        <SwitchPreferenceCompat
            app:key="auto_relogin"
            app:title="Auto Relogin"
            app:summary="Automatically log in when the app starts."
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="cat_fav"
        app:title="Favorite Boards">

        <Preference
            app:key="fav_backup"
            app:title="Backup Favorites"
            app:summary="Save your current favorite boards to your diary."/>

        <Preference
            app:key="fav_restore"
            app:title="Restore Favorites"
            app:summary="Restore your favorite boards from the latest backup in your diary."/>

    </PreferenceCategory>

    <!-- ADDED: The Menu Option setting from the original app -->
    <PreferenceCategory
        app:key="cat_ui"
        app:title="UI Settings">

        <ListPreference
            app:key="menu_option"
            app:title="Menu Display Option"
            app:entries="@array/menu_option_labels"
            app:entryValues="@array/menu_option_values"
            app:defaultValue="@string/preference_value_menuoption_actionbar"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="cat_etc"
        app:title="Etc">

        <SwitchPreferenceCompat
            app:key="disable_delete"
            app:title="Disable Delete"
            app:summary="Disable the delete function in context menus."
            app:defaultValue="false"/>

    </PreferenceCategory>

</PreferenceScreen>
